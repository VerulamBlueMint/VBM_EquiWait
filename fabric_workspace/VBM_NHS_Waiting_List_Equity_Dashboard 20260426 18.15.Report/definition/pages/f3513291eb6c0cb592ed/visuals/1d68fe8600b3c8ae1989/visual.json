            "jsonSpec": {
              "expr": {
                "Literal": {
                  "Value": "'{\n  \"title\": {\n    \"text\": \"Representation Index by Demographic Group - Over 52 Weeks\",\n    \"subtitle\": [\"Values > 1.0 indicate group is over-represented in the 52+ week band relative to their share of the total waiting list.\", \"1.0 = Proportionate representation. Values < 1.0 indicate under-representation.\", \"n = number of patients from the selected demographic group waiting over 52 weeks at this trust.\"],\n    \"fontSize\": 14,\n    \"font\": \"Segoe UI Semibold\",\n    \"anchor\": \"start\",\n    \"color\": \"#072F5C\",\n    \"subtitleColor\": \"#6B7280\",\n    \"subtitleFontSize\": 10\n  },\n  \"data\": {\"name\": \"dataset\"},\n  \"layer\": [\n    {\n      \"mark\": {\"type\": \"bar\"},\n      \"encoding\": {\n        \"y\": {\n          \"field\": \"demographic_value\",\n          \"type\": \"nominal\",\n          \"sort\": \"-x\",\n          \"title\": null\n        },\n        \"x\": {\n          \"field\": \"Representation Index (Trust)\",\n          \"type\": \"quantitative\",\n          \"title\": \"Representation Index\",\n          \"axis\": {\"format\": \".2f\"},\n          \"scale\": {\"zero\": true}\n        },\n        \"color\": {\n          \"condition\": [\n            {\n              \"test\": \"datum[''Representation Index (Trust)''] < 1\",\n              \"value\": \"#059669\"\n            },\n            {\n              \"test\": \"datum[''Representation Index (Trust)''] < 1.2\",\n              \"value\": \"#F97316\"\n            }\n          ],\n          \"value\": \"#DC2626\"\n        },\n        \"tooltip\": [\n          {\n            \"field\": \"demographic_value\",\n            \"type\": \"nominal\",\n            \"title\": \"Demographic Group\"\n          },\n          {\n            \"field\": \"Representation Index (Trust)\",\n            \"type\": \"quantitative\",\n            \"title\": \"Representation Index\",\n            \"format\": \".2f\"\n          },\n          {\n            \"field\": \"Cohort Count (Trust, Label)\",\n            \"type\": \"nominal\",\n            \"title\": \"Group Size\"\n          }\n        ]\n      }\n    },\n    {\n      \"mark\": {\"type\": \"text\", \"align\": \"left\", \"dx\": 5, \"baseline\": \"middle\"},\n      \"encoding\": {\n        \"y\": {\n          \"field\": \"demographic_value\",\n          \"type\": \"nominal\"\n        },\n        \"x\": {\"value\": 5},\n        \"text\": {\n          \"field\": \"Cohort Count (Trust, Label)\",\n          \"type\": \"nominal\"\n        },\n        \"color\": {\"value\": \"#ffffff\"}\n      }\n    },\n    {\n      \"mark\": {\"type\": \"rule\"},\n      \"encoding\": {\n        \"x\": {\"datum\": 1.0},\n        \"color\": {\"value\": \"#1D4ED8\"},\n        \"size\": {\"value\": 2}\n      }\n    },\n    {\n      \"mark\": {\n        \"type\": \"text\",\n        \"align\": \"center\",\n        \"dx\": 0,\n        \"dy\": -8,\n        \"text\": \"Equity Threshold\",\n        \"baseline\": \"bottom\",\n        \"fontSize\": 10,\n        \"fontStyle\": \"italic\"\n      },\n      \"encoding\": {\n        \"x\": {\"datum\": 1.0},\n        \"y\": {\"value\": 0},\n        \"color\": {\"value\": \"#1D4ED8\"}\n      }\n    }\n  ]\n}'"

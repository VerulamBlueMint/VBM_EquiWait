	measure 'Representation Index (Trust) Change (MoM)' =
			
			VAR current_date =
			    MAX( 'marts fact_waiting_list_geography'[snapshot_date] )
			VAR prior_date =
			    EDATE( current_date, -1 )
			VAR current_month =
			    CALCULATE(
			        [Representation Index (Trust)],
			        'marts fact_waiting_list_geography'[snapshot_date] = current_date
			    )
			VAR prior_month =
			    CALCULATE(
			        [Representation Index (Trust)],
			        'marts fact_waiting_list_geography'[snapshot_date] = prior_date
			    )
			RETURN
			    current_month - prior_month
		formatString: 0.00%;-0.00%;0.00%

	measure 'Band Share (England, Demographic Dimension Neutral)' =
			
			VAR group_in_band =
			    CALCULATE(
			        SUM( 'marts fact_waiting_list_geography'[patient_count] ),
			        ALL( 'marts dim_geography' ),
			        'marts fact_waiting_list_geography'[geography_level] = "ENGLAND",
			        'marts dim_demographic'[is_total] = 0,
			        'marts dim_demographic'[is_unknown] = 0
			    )
			VAR group_total =
			    CALCULATE(
			        SUM( 'marts fact_waiting_list_geography'[patient_count] ),
			        ALL( 'marts dim_geography' ),
			        'marts fact_waiting_list_geography'[geography_level] = "ENGLAND",
			        ALL( 'seeds dim_waiting_band' ),
			        'seeds dim_waiting_band'[is_total] = FALSE,
			        'marts dim_demographic'[is_total] = 0,
			        'marts dim_demographic'[is_unknown] = 0
			    )
			RETURN
			    DIVIDE( group_in_band, group_total )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: BREACH RATES
		lineageTag: b24deb21-c5bf-4de0-8af5-7e5e12bee0a6

	measure 'Band Share (England, Dimension Average)' =
			
			CALCULATE(
			    DIVIDE(
			        CALCULATE(
			            SUM( 'marts fact_waiting_list_geography'[patient_count] ),
			            ALL( 'marts dim_geography' ),
			            'marts fact_waiting_list_geography'[geography_level] = "ENGLAND",
			            'marts dim_demographic'[is_total] = 0,
			            'marts dim_demographic'[is_unknown] = 0,
			            'seeds dim_waiting_band'[is_total] = FALSE
			        ),
			        CALCULATE(
			            SUM( 'marts fact_waiting_list_geography'[patient_count] ),
			            ALL( 'marts dim_geography' ),
			            ALL( 'seeds dim_waiting_band' ),
			            'marts fact_waiting_list_geography'[geography_level] = "ENGLAND",
			            'marts dim_demographic'[is_total] = 0,
			            'marts dim_demographic'[is_unknown] = 0,
			            'seeds dim_waiting_band'[is_total] = FALSE
			        )
			    ),
			    ALL( 'marts dim_demographic'[demographic_value] )
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: BREACH RATES
		lineageTag: 4a6af749-58dc-4382-8506-bc5afdc6ec60

	measure 'Band Share (England, National Average for Gap Table)' =
			
			DIVIDE(
			    CALCULATE(
			        SUM( 'marts fact_waiting_list_geography'[patient_count] ),
			        ALL( 'marts dim_geography' ),
			        ALL( 'marts dim_demographic' ),
			        'marts fact_waiting_list_geography'[geography_level] = "ENGLAND",
			        'marts dim_demographic'[is_total] = 0,
			        'marts dim_demographic'[is_unknown] = 0,
			        'seeds dim_waiting_band'[is_total] = FALSE
			    ),
			    CALCULATE(
			        SUM( 'marts fact_waiting_list_geography'[patient_count] ),
			        ALL( 'marts dim_geography' ),
			        ALL( 'marts dim_demographic' ),
			        ALL( 'seeds dim_waiting_band' ),
			        'marts fact_waiting_list_geography'[geography_level] = "ENGLAND",
			        'marts dim_demographic'[is_total] = 0,
			        'marts dim_demographic'[is_unknown] = 0,
			        'seeds dim_waiting_band'[is_total] = FALSE
			    )
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: BREACH RATES
		lineageTag: 8f05804a-310e-4fe0-aa5e-8feee4427823

	measure 'Band Share (England, Overall)' =
			
			CALCULATE(
			    SUM( 'marts fact_waiting_list_geography'[patient_count] ),
			    ALL( 'marts dim_geography' ),
			    ALL( 'marts dim_demographic' ),
			    'marts fact_waiting_list_geography'[geography_level] = "ENGLAND",
			    'marts dim_demographic'[is_total] = 0,
			    'marts dim_demographic'[is_unknown] = 0,
			    'seeds dim_waiting_band'[is_total] = FALSE
			) /
			CALCULATE(
			    SUM( 'marts fact_waiting_list_geography'[patient_count] ),
			    ALL( 'marts dim_geography' ),
			    ALL( 'marts dim_demographic' ),
			    ALL( 'seeds dim_waiting_band' ),
			    'marts fact_waiting_list_geography'[geography_level] = "ENGLAND",
			    'marts dim_demographic'[is_total] = 0,
			    'marts dim_demographic'[is_unknown] = 0,
			    'seeds dim_waiting_band'[is_total] = FALSE
			)
		displayFolder: BREACH RATES
		lineageTag: 9bd3740f-80f1-4dda-9071-aca9285aaa21


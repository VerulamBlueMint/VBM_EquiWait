	measure 'Local Burden Supporting Text (Part 2)' = ```
			
			VAR excess = [Local Burden Value]
			RETURN
			    "This reflects the scale of over-representation where it occurs and does not indicate a national imbalance."
			
			```
		displayFolder: NARRATIVE AND TITLES
		lineageTag: ca1b8bbb-2e18-4ba8-9785-e64c4380aac5

	measure 'Local Burden Value' =
			
			VAR burden = SUMX(
			    FILTER(
			        ALL( 'marts dim_geography' ),
			        LEFT( 'marts dim_geography'[trust_code], 1 ) <> "Y" &&
			        LEFT( 'marts dim_geography'[trust_code], 1 ) <> "Q" &&
			        'marts dim_geography'[is_current] = 1
			    ),
			    VAR current_trust = 'marts dim_geography'[trust_code]
			    VAR group_in_band =
			        CALCULATE(
			            SUM( 'marts fact_waiting_list_geography'[patient_count] ),
			            FILTER( ALL( 'marts dim_geography' ), 'marts dim_geography'[trust_code] = current_trust ),
			            'marts fact_waiting_list_geography'[geography_level] = "NHS ACUTE",
			            'marts dim_demographic'[is_total] = 0,
			            'marts dim_demographic'[is_unknown] = 0
			        )
			    VAR group_all_bands =
			        CALCULATE(
			            SUM( 'marts fact_waiting_list_geography'[patient_count] ),
			            FILTER( ALL( 'marts dim_geography' ), 'marts dim_geography'[trust_code] = current_trust ),
			            'marts fact_waiting_list_geography'[geography_level] = "NHS ACUTE",
			            ALL( 'seeds dim_waiting_band' ),
			            'seeds dim_waiting_band'[is_total] = FALSE,
			            'marts dim_demographic'[is_total] = 0,
			            'marts dim_demographic'[is_unknown] = 0
			        )
			    VAR trust_in_band =
			        CALCULATE(
			            SUM( 'marts fact_waiting_list_geography'[patient_count] ),
			            FILTER( ALL( 'marts dim_geography' ), 'marts dim_geography'[trust_code] = current_trust ),
			            'marts fact_waiting_list_geography'[geography_level] = "NHS ACUTE",
			            REMOVEFILTERS( 'marts dim_demographic' ),
			            'marts dim_demographic'[demographic_dimension] = "Age",
			            'marts dim_demographic'[is_total] = 0
			        )
			    VAR trust_all_bands =
			        CALCULATE(
			            SUM( 'marts fact_waiting_list_geography'[patient_count] ),
			            FILTER( ALL( 'marts dim_geography' ), 'marts dim_geography'[trust_code] = current_trust ),
			            'marts fact_waiting_list_geography'[geography_level] = "NHS ACUTE",
			            REMOVEFILTERS( 'marts dim_demographic' ),
			            'marts dim_demographic'[demographic_dimension] = "Age",
			            ALL( 'seeds dim_waiting_band' ),
			            'seeds dim_waiting_band'[is_total] = FALSE,
			            'marts dim_demographic'[is_total] = 0
			        )
			    VAR group_share = DIVIDE( group_in_band, group_all_bands )
			    VAR trust_share = DIVIDE( trust_in_band, trust_all_bands )
			    VAR result = ( group_share - trust_share ) * group_all_bands
			    RETURN
			        IF( result <= 0 || ISBLANK( group_share ) || group_all_bands = 0, 0, result )
			)
			RETURN
			    IF( burden = 0, BLANK(), burden )
		displayFolder: NARRATIVE AND TITLES
		lineageTag: efa951d3-d99c-4519-83b0-39cfabc8f4ee

		annotation PBI_FormatHint = {"isGeneralNumber":true}


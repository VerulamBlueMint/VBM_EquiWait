	measure 'Worst Equity Group' = ```
			
			VAR LatestSnapshot =
			    CALCULATE(
			        MAX( 'marts fact_waiting_list_geography'[snapshot_date] ),
			        REMOVEFILTERS( 'marts fact_waiting_list_geography'[snapshot_date] )
			    )
			VAR Summary =
			    CALCULATETABLE(
			        SUMMARIZECOLUMNS(
			            'marts dim_geography'[trust_code],
			            'marts dim_geography'[trust_name],
			            'marts dim_demographic'[demographic_value],
			            "cohort", [Cohort Count],
			            "idx", [Representation Index (Trust)]
			        ),
			        'marts fact_waiting_list_geography'[geography_level] = "NHS ACUTE",
			        LEFT( 'marts dim_geography'[trust_code], 1 ) <> "Y",
			        LEFT( 'marts dim_geography'[trust_code], 1 ) <> "Q",
			        'marts fact_waiting_list_geography'[snapshot_date] = LatestSnapshot,
			        'marts dim_demographic'[demographic_dimension] = "Ethnicity",
			        'marts dim_demographic'[is_unknown] = 0,
			        'marts dim_demographic'[is_total] = 0,
			        'seeds dim_waiting_band'[band_label] IN { "18 To 52 Weeks", "Over 52 Weeks" }
			    )
			VAR Filtered =
			    FILTER( Summary, [cohort] >= 100 )
			VAR TopRow =
			    TOPN( 1, Filtered, [idx], DESC )
			VAR RawName = MAXX( TopRow, 'marts dim_demographic'[demographic_value] )
			RETURN
			    TRIM( MID( RawName, FIND( ":", RawName ) + 1, LEN( RawName ) ) )
			
			```
		displayFolder: WORST PERFORMERS
		lineageTag: e3603659-79b0-4f6e-b3c8-db1681f0a582


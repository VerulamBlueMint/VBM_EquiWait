	measure 'Local Burden Supporting Text (Part 1)' = ```
			
			VAR excess = [Local Burden Value]
			RETURN
			    "Across trusts where this group is over-represented in this band, there are " &
			    FORMAT( excess, "#,0" ) &
			    " excess patients."
			
			```

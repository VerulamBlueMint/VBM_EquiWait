table _Measures
	lineageTag: 7408e90b-1fef-494e-b396-e35a874d1e75

	measure 'Divergence Direction' =
			
			VAR br_change = [Breach Rate (Trust) Change (MoM)]
			VAR ri_change = [Representation Index (Trust) Change (MoM)]
			RETURN
			    SWITCH(
			        TRUE(),
			        br_change < 0 && ri_change < 0, "Both improving",
			        br_change > 0 && ri_change > 0, "Both worsening",
			        br_change < 0 && ri_change > 0, "Performance up, Equity down",
			        br_change > 0 && ri_change < 0, "Performance down, Equity up",
			        br_change = 0 && ri_change = 0, "Both unchanged",
			        br_change = 0 && ri_change < 0, "Performance unchanged, Equity improving",
			        br_change = 0 && ri_change > 0, "Performance unchanged, Equity worsening",
			        br_change < 0 && ri_change = 0, "Performance improving, Equity unchanged",
			        br_change > 0 && ri_change = 0, "Performance worsening, Equity unchanged",
			        BLANK()
			    )
		displayFolder: ADMIN AND GUARDS
		lineageTag: ba25539c-bd5d-463e-b09e-ddfb925d43d3

	measure 'Divergence Flag' = ```
			
			VAR br = [Breach Rate (Trust)]
			VAR ri = [Representation Index (Trust)]
			RETURN
			    IF(
			        AND( br < 0.39, ri > 1.2 ),
			        "⚠ Equity concern despite good performance",
			        ""
			    )
			
			```
		displayFolder: ADMIN AND GUARDS
		lineageTag: ab60dcf9-68ae-49ab-8e2c-2733f9b559ae

	measure 'Is Acute Trust' = ```
			
			IF(
			    AND(
			        LEFT( MAX( 'marts dim_geography'[trust_code] ), 1 ) <> "Q",
			        LEFT( MAX( 'marts dim_geography'[trust_code] ), 1 ) <> "Y"
			    ),
			    1,
			    0
			)
			
			```
		formatString: 0
		displayFolder: ADMIN AND GUARDS
		lineageTag: 94aac95b-cd41-470a-bca5-bfb243a97622

	measure 'Number of Trusts' = ```
			
			DISTINCTCOUNT( 'stats stat_funnel_results'[trust_code] )
			
			```
		formatString: 0
		displayFolder: ADMIN AND GUARDS
		lineageTag: 547a80ed-9793-4fe7-8d35-fcc936e26434

	measure 'Snapshot Months' = ```
			

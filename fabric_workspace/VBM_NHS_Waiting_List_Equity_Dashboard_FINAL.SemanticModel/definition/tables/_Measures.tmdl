			VAR total = [Total Waiting List (England, Latest Snapshot)]
			RETURN
			    "There are currently " & FORMAT( total, "#,##0" ) & " patients on the NHS waiting list in England."
			
			```
		displayFolder: NARRATIVE AND TITLES
		lineageTag: 4aa0e603-2e54-4f20-b33c-99d59006dc14

	measure 'Worst Equity Statement' = ```
			
			VAR LatestSnapshot =
			    CALCULATE(
			        MAX( 'marts fact_waiting_list_geography'[snapshot_date] ),
			        REMOVEFILTERS( 'marts fact_waiting_list_geography'[snapshot_date] )
			    )
			VAR Summary =
			    CALCULATETABLE(
			        SUMMARIZECOLUMNS(
			            'marts dim_geography'[trust_code],
			            'marts dim_geography'[trust_name],
			            'marts dim_demographic'[demographic_value],
			            "cohort", [Cohort Count],
			            "idx", [Representation Index (Trust)]
			        ),
			        'marts fact_waiting_list_geography'[geography_level] = "NHS ACUTE",
			        LEFT( 'marts dim_geography'[trust_code], 1 ) <> "Y",
			        LEFT( 'marts dim_geography'[trust_code], 1 ) <> "Q",
			        'marts fact_waiting_list_geography'[snapshot_date] = LatestSnapshot,
			        'marts dim_demographic'[demographic_dimension] = "Ethnicity",
			        'marts dim_demographic'[is_unknown] = 0,
			        'marts dim_demographic'[is_total] = 0,
			        'seeds dim_waiting_band'[band_label] IN { "18 To 52 Weeks", "Over 52 Weeks" }
			    )
			VAR Filtered =
			    FILTER( Summary, [cohort] >= 100 )
			VAR TopRow =
			    TOPN( 1, Filtered, [idx], DESC )
			VAR TrustName = MAXX( TopRow, 'marts dim_geography'[trust_name] )
			VAR RawName = MAXX( TopRow, 'marts dim_demographic'[demographic_value] )
			VAR GroupName = TRIM( MID( RawName, FIND( ":", RawName ) + 1, LEN( RawName ) ) )
			VAR GroupIndex = MAXX( TopRow, [idx] )
			VAR PctAbove = FORMAT( ROUND( ( GroupIndex - 1 ) * 100, 0 ), "0" )
			RETURN
			    GroupName & " patients at " & TrustName & " are " & PctAbove & "% more likely to be waiting over 18 weeks than the average patient."
			
			```
		displayFolder: NARRATIVE AND TITLES
		lineageTag: 99aecc5b-6578-4855-8842-46b00f0495e2

	measure 'Representation Index (England, Treatment Function)' = ```
			
			VAR group_in_band =
			    CALCULATE(
			        SUM( 'marts fact_waiting_list_specialty'[patient_count] ),
			        'seeds dim_waiting_band'[is_total] = FALSE,
			        'marts dim_demographic'[is_total] = 0,
			        'marts dim_demographic'[is_unknown] = 0
			    )
			VAR band_total =
			    CALCULATE(
			        SUM( 'marts fact_waiting_list_specialty'[patient_count] ),
			        ALL( 'marts dim_demographic' ),
			        'seeds dim_waiting_band'[is_total] = FALSE,
			        'marts dim_demographic'[is_total] = 0,
			        'marts dim_demographic'[is_unknown] = 0
			    )
			VAR group_in_total =
			    CALCULATE(
			        SUM( 'marts fact_waiting_list_specialty'[patient_count] ),
			        ALL( 'seeds dim_waiting_band' ),
			        'marts dim_demographic'[is_total] = 0,
			        'marts dim_demographic'[is_unknown] = 0
			    )
			VAR list_total =
			    CALCULATE(
			        SUM( 'marts fact_waiting_list_specialty'[patient_count] ),
			        ALL( 'marts dim_demographic' ),
			        ALL( 'seeds dim_waiting_band' ),
			        'marts dim_demographic'[is_total] = 0,
			        'marts dim_demographic'[is_unknown] = 0
			    )
			RETURN
			    DIVIDE(
			        DIVIDE( group_in_band, band_total ),
			        DIVIDE( group_in_total, list_total )
			    )
			
			
			```
		displayFolder: REPRESENTATION INDEX
		lineageTag: cc12d0a1-3f2a-4f79-b503-a48a8213a2dd


	measure 'Breach Rate (Band Share)' =
			
			VAR band_patients =
			    CALCULATE(
			        SUM( 'marts fact_waiting_list_geography'[patient_count] ),
			        'marts fact_waiting_list_geography'[geography_level] = "NHS ACUTE",
			        LEFT( 'marts dim_geography'[trust_code], 1 ) <> "Y",
			        LEFT( 'marts dim_geography'[trust_code], 1 ) <> "Q",
			        'marts dim_demographic'[demographic_dimension] = "Age",
			        'marts dim_demographic'[is_total] = 0
			    )
			VAR trust_total =
			    CALCULATE(
			        SUM( 'marts fact_waiting_list_geography'[patient_count] ),
			        'marts fact_waiting_list_geography'[geography_level] = "NHS ACUTE",
			        LEFT( 'marts dim_geography'[trust_code], 1 ) <> "Y",
			        LEFT( 'marts dim_geography'[trust_code], 1 ) <> "Q",
			        'marts dim_demographic'[demographic_dimension] = "Age",
			        ALL( 'seeds dim_waiting_band' ),
			        'seeds dim_waiting_band'[is_total] = FALSE,
			        'marts dim_demographic'[is_total] = 0
			    )
			RETURN
			    DIVIDE( band_patients, trust_total )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: BREACH RATES
		lineageTag: 962863ac-5f99-48d2-a5f2-405dac98028b

	measure 'Breach Rate (England, Demographic Dimension Neutral)' =
			
			VAR breached =
			    CALCULATE(
			        SUM( 'marts fact_waiting_list_geography'[patient_count] ),
			        'marts fact_waiting_list_geography'[geography_level] = "ENGLAND",
			        'seeds dim_waiting_band'[band_label] IN { "18 To 52 Weeks", "Over 52 Weeks" },
			        'marts dim_demographic'[is_total] = 0,
			        'marts dim_demographic'[is_unknown] = 0
			    )
			VAR total =
			    CALCULATE(
			        SUM( 'marts fact_waiting_list_geography'[patient_count] ),
			        'marts fact_waiting_list_geography'[geography_level] = "ENGLAND",
			        ALL( 'seeds dim_waiting_band' ),
			        'seeds dim_waiting_band'[is_total] = FALSE,
			        'marts dim_demographic'[is_total] = 0,
			        'marts dim_demographic'[is_unknown] = 0
			    )
			RETURN
			    DIVIDE( breached, total )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: BREACH RATES
		lineageTag: d77e826f-1b32-4c7e-8f2a-7fcac8eec2b0


	measure 'Breach Rate (England) Change (MoM)' = ```
			
			VAR current_month =
			    CALCULATE(
			        [Breach Rate (England)],
			        LASTNONBLANK( 'dim_date'[Date], [Breach Rate (England)] )
			    )
			VAR prior_month =
			    CALCULATE(
			        [Breach Rate (England)],
			        LASTNONBLANK(
			            DATEADD( 'dim_date'[Date], -1, MONTH ),
			            [Breach Rate (England)]
			        )
			    )
			RETURN
			    current_month - prior_month
			
			```
		formatString: 0%;-0%;0%
		displayFolder: BREACH RATES
		lineageTag: b81f5c50-5ef0-41aa-b2b0-56eb0b9ccafc


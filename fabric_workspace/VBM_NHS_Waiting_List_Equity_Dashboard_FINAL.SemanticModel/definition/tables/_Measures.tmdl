	measure 'Worst Region Breach Rate' = ```
			
			VAR LatestSnapshot =
			    CALCULATE(
			        MAX( 'marts fact_waiting_list_geography'[snapshot_date] ),
			        REMOVEFILTERS( 'marts fact_waiting_list_geography'[snapshot_date] )
			    )
			VAR RegionRates =
			    ADDCOLUMNS(
			        FILTER(
			            VALUES( 'marts dim_geography'[trust_code] ),
			            LEFT( 'marts dim_geography'[trust_code], 1 ) = "Y"
			        ),
			        "rate",
			        CALCULATE(
			            [Breach Rate (Region)],
			            TREATAS( { LatestSnapshot }, 'marts fact_waiting_list_geography'[snapshot_date] )
			        )
			    )
			RETURN
			    MAXX( TOPN( 1, RegionRates, [rate], DESC ), [rate] )
			
			```
		formatString: 0
		displayFolder: WORST PERFORMERS
		lineageTag: 76e43274-a124-4ac6-a0c6-97259eb4f4f6


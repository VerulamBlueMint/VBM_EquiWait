	measure 'Breach Rate (Trust) Change (MoM)' =
			
			VAR all_dates =
			    VALUES( 'marts fact_waiting_list_geography'[snapshot_date] )
			VAR current_date =
			    MAXX( all_dates, 'marts fact_waiting_list_geography'[snapshot_date] )
			VAR prior_date =
			    EDATE( current_date, -1 )
			VAR current_month =
			    CALCULATE(
			        [Breach Rate (Trust, Demographic Dimension Neutral)],
			        'marts fact_waiting_list_geography'[snapshot_date] = current_date
			    )
			VAR prior_month =
			    CALCULATE(
			        [Breach Rate (Trust, Demographic Dimension Neutral)],
			        'marts fact_waiting_list_geography'[snapshot_date] = prior_date
			    )
			RETURN
			    current_month - prior_month
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: BREACH RATES
		lineageTag: a9e7b435-9beb-4550-a7c1-45998c27b6e4

	measure 'Breach Rate (Trust) Volatility' = ```
			
			VAR monthly_rates =
			    ADDCOLUMNS(
			        VALUES( 'dim_date'[year_month] ),
			        "rate", CALCULATE( [Breach Rate (Trust)] )
			    )
			VAR avg_rate =
			    AVERAGEX( monthly_rates, [rate] )
			VAR sum_sq_diff =
			    AVERAGEX(
			        monthly_rates,
			        ( [rate] - avg_rate ) ^ 2
			    )
			RETURN
			    SQRT( sum_sq_diff )
			
			```
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: BREACH RATES
		lineageTag: e217e0fb-c1a0-4007-8c80-f054b14b3bfa


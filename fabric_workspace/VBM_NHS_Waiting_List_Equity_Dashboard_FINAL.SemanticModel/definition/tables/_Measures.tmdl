			        LEFT( 'marts dim_geography'[trust_code], 1 ) <> "Y",
			        LEFT( 'marts dim_geography'[trust_code], 1 ) <> "Q",
			        'marts dim_demographic'[demographic_dimension] = "Age",
			        'seeds dim_waiting_band'[band_label] IN { "18 To 52 Weeks", "Over 52 Weeks" },
